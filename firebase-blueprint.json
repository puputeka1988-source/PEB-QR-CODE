{
  "entities": {
    "students": {
      "title": "Students",
      "description": "Collection of student records in the school",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nisn": { "type": "string" },
        "class": { "type": "string" },
        "gender": { "type": "string" },
        "parentPhone": { "type": "string" },
        "photoUrl": { "type": "string" }
      },
      "required": ["name", "nisn", "class"]
    },
    "attendance": {
      "title": "Attendance Records",
      "description": "Daily attendance logs for students",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentNisn": { "type": "string" },
        "class": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" },
        "method": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["studentId", "date", "status"]
    },
    "journals": {
      "title": "Teaching Journals",
      "description": "Daily teaching journals logged by teachers",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "day": { "type": "string" },
        "kelas": { "type": "string" },
        "mapel": { "type": "string" },
        "materi": { "type": "string" },
        "metode": { "type": "string" },
        "siswaTidakHadirNama": { "type": "string" },
        "catatan": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["date", "kelas", "materi"]
    },
    "settings": {
      "title": "App Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "sekolah": { "type": "string" },
        "npsn": { "type": "string" },
        "alamat": { "type": "string" },
        "jamMasuk": { "type": "string" },
        "jamTerlambat": { "type": "string" },
        "namaGuru": { "type": "string" },
        "nip": { "type": "string" },
        "mataPelajaran": { "type": "string" },
        "kotaTandaTangan": { "type": "string" },
        "semester": { "type": "string" },
        "tahunAjaran": { "type": "string" },
        "twoFactorEnabled": { "type": "boolean" },
        "securityPin": { "type": "string" },
        "biometricEnabled": { "type": "boolean" },
        "biometricCredentialId": { "type": "string" },
        "biometricDeviceName": { "type": "string" }
      }
    },
    "academic_years": {
      "title": "Academic Years",
      "description": "Academic year and semester configurations",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "semester": { "type": "string" },
        "isCurrent": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "semester"]
    },
    "teaching_schedules": {
      "title": "Teaching Schedules",
      "description": "Weekly teaching schedule items and workload",
      "type": "object",
      "properties": {
        "day": { "type": "string" },
        "dayIndex": { "type": "number" },
        "jamKe": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "kelas": { "type": "string" },
        "mapel": { "type": "string" },
        "jp": { "type": "number" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["day", "kelas", "jp"]
    },
    "gradeSheets": {
      "title": "Class Grade Sheets",
      "description": "Daily grade records for classes and subjects",
      "type": "object",
      "properties": {
        "kelas": { "type": "string" },
        "semester": { "type": "string" },
        "tahunAjaran": { "type": "string" },
        "mapel": { "type": "string" },
        "uhMeta": { "type": "object" },
        "studentGrades": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["kelas", "semester", "tahunAjaran"]
    },
    "announcements": {
      "title": "Announcements and Broadcasts",
      "description": "Direct broadcast messages and announcements targeted to all classes, specific classes, or individual students",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "targetType": { "type": "string" },
        "targetClasses": { "type": "array" },
        "targetStudentIds": { "type": "array" },
        "targetStudentNames": { "type": "array" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "priority": { "type": "string" },
        "attachmentUrl": { "type": "string" },
        "readBy": { "type": "object" }
      },
      "required": ["title", "content", "category", "targetType", "authorName", "date", "createdAt"]
    }
  }
}
